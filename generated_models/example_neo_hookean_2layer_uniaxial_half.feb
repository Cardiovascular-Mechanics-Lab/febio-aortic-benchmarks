    <load_controller id="1" name="LC1" type="loadcurve">
      <interpolate>LINEAR</interpolate>
      <extend>CONSTANT</extend>
      <points>
        <pt>0,0</pt>
        <pt>1,1</pt>
      </points>
    </load_controller>
  </LoadData>

  <Output>
    <plotfile type="febio">
      <var type="displacement"/>
      <var type="stress"/>
      <var type="Lagrange strain"/>
      <var type="relative volume"/>
      <var type="reaction forces"/>
    </plotfile>
    <logfile>
      <node_data data="Rx" file="example_neo_hookean_2layer_uniaxial_half.feb_Rx_data.txt" node_set="right_face"/>
    </logfile>
  </Output>

</febio_spec>
